[Unit]
Description=Polymarket Soccer Margins Monitor Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace 'ubuntu' with your actual username on the server (run 'whoami' to find out)
User=ariel25621
Group=ariel25621

# Updated to match your GCP username and folder name
WorkingDirectory=/home/ariel25621/soccer_monitor
ExecStart=/home/ariel25621/soccer_monitor/venv/bin/python soccer_monitor.py

Restart=on-failure
RestartSec=10
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
