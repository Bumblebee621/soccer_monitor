[Unit]
Description=Polymarket Soccer Margins Monitor Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# Paths match the Oracle Cloud Ubuntu image default user
WorkingDirectory=/home/ubuntu/soccer_monitor
ExecStart=/home/ubuntu/soccer_monitor/venv/bin/python soccer_monitor.py

Restart=on-failure
RestartSec=10
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
