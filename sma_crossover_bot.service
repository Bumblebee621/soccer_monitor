[Unit]
Description=S&P 500 SMA Crossover Alert Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ariel25621
Group=ariel25621
WorkingDirectory=/home/ariel25621/soccer_monitor
ExecStart=/home/ariel25621/soccer_monitor/venv/bin/python sma_crossover_bot.py
Restart=on-failure
RestartSec=30
LimitNOFILE=65536
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
